{
    "name": "kjgcoop/vikunja-api",
    "description": "Minimal PHP wrapper for the Vikunja REST API v1",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Vikunja\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Vikunja\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit"
    }
}
